# Product-local dependency state and test caches.
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
test-results/

# Never track a developer's secrets, data, runtime state, or evidence.
*.env
.env.*
secrets/
_local/
_artifacts/

# Separately delivered operator packages are never harness source.
*.bundle
*.bundle.*

# Playwright MCP screenshots/videos.
.playwright-mcp/
